Add postorder traversal for binary tree

//python code

class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

def insert(root, data):
    if root is None:
        return Node(data)
    if data < root.data:
        root.left = insert(root.left, data)
    else:
        root.right = insert(root.right, data)
    return root

def postorder(root):
    if root is None:
        return
    postorder(root.left)
    postorder(root.right)
    print(root.data, end=" ")

# Input
n = 5
arr = [3, 4, 5, 6, 7]

# Build BST
root = None
for x in arr:
    root = insert(root, x)

# Output
print("postorder Traversal of BST:")
postorder(root)
